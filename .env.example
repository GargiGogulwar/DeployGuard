# Copy to .env (never commit .env) and change the placeholder values.
APP_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# 127.0.0.1 = only reachable from this machine (safe default for local demos)
BIND_ADDRESS=127.0.0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-use
# Optional: enables POST /api/deployments (leave empty to disable)
DEPLOYGUARD_API_TOKEN=
DEPLOYGUARD_ENV=local
